@model List<TodoList>
<div class="col-md-12 col-xl-4 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yapılacaklar Listesi</h4>
            <form method="post" action="/TodoList/AddTodo" class="add-items d-flex">
                <input type="text" name="Content" class="form-control" placeholder="Yeni görev..." required>
                <button type="submit" class="btn btn-primary">Ekle</button>
            </form>
            <div class="list-wrapper">
                <ul class="d-flex flex-column-reverse text-white todo-list-custom" style="list-style:none;padding-left:0;">
                    @foreach (var item in Model)
                    {
                        <li class="d-flex align-items-center @(item.Status ? "completed" : "")">
                            <div class="form-check form-check-primary">
                                <label class="form-check-label" style="@(item.Status ? "text-decoration:line-through;" : "")">
                                    <input type="checkbox" @(item.Status ? "checked" : "") onchange="location.href='/TodoList/ChangeStatus/@item.ToDoListId'">@item.Content
                                </label>
                            </div>
                            <a href="/TodoList/DeleteTodo/@item.ToDoListId" class="text-danger ml-auto" title="Sil"><i class="mdi mdi-close-box"></i></a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
